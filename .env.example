# Copy to .env and fill in. Never commit the real .env file.
# This file grows as providers/services are added — see README "Quick start"
# for how to obtain free API keys once that section is written.

APP_ENV=development
LOG_LEVEL=INFO

OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:3b is the configuration docs/EVALUATION.md measures as best of those tried.
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Provider chain, first is preferred. Use "ollama" alone for fully local and free,
# or "ollama,openai" to fail over to a hosted model when the local one is down.
# Any OpenAI-compatible host works (OpenAI, Groq, OpenRouter...): set OPENAI_BASE_URL.
LLM_PROVIDER_CHAIN=ollama
# Embeddings never fail over (different models = different vector spaces).
EMBEDDING_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_FAILURE_THRESHOLD=3
LLM_COOLDOWN_SECONDS=30

# Vector store (ADR-0004)
QDRANT_URL=http://localhost:6333

# Relational store (dev-only placeholder credentials -- change for any
# non-local deployment; never commit a real password here)
POSTGRES_USER=domain_copilot
POSTGRES_PASSWORD=domain_copilot_dev
POSTGRES_DB=domain_copilot
POSTGRES_HOST=localhost
# Host port for the compose Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

# API (FR-8, section 5). Outside development the app refuses to start with a
# default or short JWT_SECRET. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_MINUTES=60
# Comma-separated browser origins allowed by CORS. Empty = same-origin only.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120
LOGIN_ATTEMPTS_PER_MINUTE=5
MAX_BODY_BYTES=1000000
UPLOAD_MAX_BYTES=10000000
# Questions per user per minute (each one costs model tokens).
ASK_PER_MINUTE=20
# Password for the seeded demo accounts (scripts/seed_users.py). Demo only.
DEMO_PASSWORD=demo-password-change-me
