# Copy to .env and fill in. Never commit the real .env file.
# This file grows as providers/services are added — see README "Quick start"
# for how to obtain free API keys once that section is written.

APP_ENV=development
LOG_LEVEL=INFO

# LLM provider selection (ADR-0003) -- "openai" or "ollama"
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text
# OPENAI_API_KEY=

# Vector store (ADR-0004)
QDRANT_URL=http://localhost:6333

# Relational store (dev-only placeholder credentials -- change for any
# non-local deployment; never commit a real password here)
POSTGRES_USER=domain_copilot
POSTGRES_PASSWORD=domain_copilot_dev
POSTGRES_DB=domain_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
